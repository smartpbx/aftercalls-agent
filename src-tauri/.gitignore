# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Platform ffmpeg sidecar — downloaded per-platform by CI (release.yml
# "Fetch ffmpeg sidecar" step) or copied in locally for pnpm tauri:dev.
# The per-triple files are big and platform-specific; not checked in.
/binaries/

# Extracted from the exact checksum-verified sidecar archive by the same
# provisioning scripts. Tauri bundles it as licenses/FFmpeg-LICENSE.txt.
/resources/FFmpeg-LICENSE.txt
/resources/THIRD_PARTY_NOTICES.md
