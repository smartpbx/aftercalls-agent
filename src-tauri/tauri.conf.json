{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aftercalls",
  "version": "0.32.1",
  "identifier": "io.aftercalls.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aftercalls",
        "width": 800,
        "height": 600,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/recordings/*/mic.wav",
          "$APPLOCALDATA/recordings/*/system.wav",
          "$APPLOCALDATA/recordings/*/mixed.wav"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg-aftercalls"],
    "resources": {
      "resources/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "resources/FFmpeg-LICENSE.txt": "licenses/FFmpeg-LICENSE.txt"
    },
    "macOS": {
      "entitlements": "aftercalls.entitlements",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "providerShortName": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCOTlDODM3MTlBNEI2OTcKUldTWHRxUVpOOGlaeTJWbVFKc1Byalc0cGhndGM3djlCcDdmMll4MVRnUWp5SEd2WEZMTWxUcDkK",
      "endpoints": [
        "https://aftercalls-updates.tor1.digitaloceanspaces.com/latest.json"
      ]
    }
  }
}
