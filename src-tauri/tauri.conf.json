{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aftercalls",
  "version": "0.1.0",
  "identifier": "io.aftercalls.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aftercalls",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**", "$APPLOCALDATA/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCOTlDODM3MTlBNEI2OTcKUldTWHRxUVpOOGlaeTJWbVFKc1Byalc0cGhndGM3djlCcDdmMll4MVRnUWp5SEd2WEZMTWxUcDkK",
      "endpoints": [
        "https://github.com/smartpbx/aftercalls/releases/latest/download/latest.json"
      ]
    }
  }
}
