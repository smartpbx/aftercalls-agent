{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the trusted local main window.",
  "windows": ["main"],
  "permissions": [
    "main-commands",
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-inner-size",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-html",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://aftercalls.io/**" },
        { "url": "https://app.aftercalls.io/**" },
        { "url": "http://localhost:5173/**" },
        { "url": "http://127.0.0.1:5173/**" },
        { "url": "https://crm.zoho.com/**" },
        { "url": "https://crm.zoho.eu/**" },
        { "url": "https://crm.zoho.in/**" },
        { "url": "https://crm.zoho.com.au/**" },
        { "url": "https://crm.zoho.jp/**" },
        { "url": "https://crm.zohocloud.ca/**" },
        { "url": "https://desk.zoho.com/**" },
        { "url": "https://desk.zoho.eu/**" },
        { "url": "https://desk.zoho.in/**" },
        { "url": "https://desk.zoho.com.au/**" },
        { "url": "https://desk.zoho.jp/**" },
        { "url": "https://desk.zohocloud.ca/**" }
      ]
    }
  ]
}
