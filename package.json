{
  "name": "aftercalls-agent",
  "version": "0.1.0",
  "description": "aftercalls desktop agent — records calls, transcribes, summarizes.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:dev": "AFTERCALLS_PROFILE=dev GDK_BACKEND=x11 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev"
  },
  "pnpm": {
    "overrides": {
      "@sveltejs/kit>cookie": "0.7.2",
      "vite>postcss": "8.5.25"
    }
  },
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@aftercalls/shared": "file:packages/shared",
    "@sentry/browser": "^10.51.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "linkify-it": "^5.0.2",
    "markdown-it": "14.2.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.6.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
